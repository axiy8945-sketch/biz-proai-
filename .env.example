# --- Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Needed to create employee logins, run the daily-report cron and the Telegram webhook.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (optional; without it the coordinator answers with exact deterministic reports)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Daily reports cron (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=

# --- Telegram (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
